#!/usr/bin/env bash
# adb-qr-pair — pair an Android device for wireless debugging from the terminal.
#
#   QR mode (default): prints a QR code. On the phone open
#     Developer options → Wireless debugging → Pair device with QR code, and scan it.
#   Code mode (-c):    on the phone choose "Pair device with pairing code";
#     the script finds the device via mDNS and asks for the 6-digit code.
#
# Requires: adb (platform-tools ≥ 30) and, for QR mode, qrencode.
# Host and phone must be on the same network (mDNS must not be blocked).

set -euo pipefail

TIMEOUT=120
MODE=qr
CONNECT=1

usage() {
  cat <<EOF
Usage: $(basename "$0") [-c] [-t SECONDS] [-n]
  -c          pairing-code mode instead of QR code
  -t SECONDS  how long to wait for the device (default: $TIMEOUT)
  -n          don't run 'adb connect' after pairing
  -h          show this help
EOF
}

while getopts "ct:nh" opt; do
  case $opt in
    c) MODE=code ;;
    t) TIMEOUT=$OPTARG ;;
    n) CONNECT=0 ;;
    h) usage; exit 0 ;;
    *) usage; exit 2 ;;
  esac
done

die() { printf '\e[31merror:\e[0m %s\n' "$*" >&2; exit 1; }
warn() { printf '\e[33m!\e[0m %s\n' "$*" >&2; }
info() { printf '\e[36m›\e[0m %s\n' "$*"; }
ok() { printf '\e[32m✔\e[0m %s\n' "$*"; }

ADB=$(command -v adb) || die "adb not found in PATH"
adb() { "$ADB" "$@"; }
[[ $MODE == qr ]] && { command -v qrencode >/dev/null || die "qrencode not found (install the 'qrencode' package)"; }

mdns_ok() { [[ $(adb mdns services 2>&1 || true) != *"unknown host service"* ]]; }

# Executable of the running adb server (Linux /proc only; empty if unknown).
server_exe() {
  local pid
  for pid in $(pgrep -x adb 2>/dev/null); do
    if tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q 'fork-server'; then
      readlink "/proc/$pid/exe" 2>/dev/null && return
    fi
  done
}

adb_version() { "$1" version 2>/dev/null | sed -n 's/^Version //p'; }
is_distro_build() { [[ $(adb_version "$1") == *android-tools* || $(adb_version "$1") == *debian* ]]; }

# Distinct adb executables: PATH entries plus usual SDK locations.
adb_candidates() {
  local p seen=""
  for p in $(type -ap adb) \
    ${ANDROID_HOME:+"$ANDROID_HOME/platform-tools/adb"} \
    ${ANDROID_SDK_ROOT:+"$ANDROID_SDK_ROOT/platform-tools/adb"} \
    "$HOME/Android/Sdk/platform-tools/adb" "$HOME/Library/Android/sdk/platform-tools/adb"; do
    [[ -x $p ]] || continue
    p=$(readlink -f "$p" 2>/dev/null || echo "$p")
    [[ " $seen " == *" $p "* ]] && continue
    seen+=" $p"
    echo "$p"
  done
}

# Interactive fix when the running server lacks mDNS: pick an adb and restart the server.
fix_mdns_wizard() {
  local srv cands=() c i choice def=1 ndev
  srv=$(server_exe)
  warn "The running adb server has no mDNS support${srv:+ (started by $srv, $(adb_version "$srv"))}."
  if [[ ! -t 0 ]]; then
    die "restart it with an adb that supports mDNS: 'adb kill-server', then rerun (or set ADB_MDNS_OPENSCREEN=1)."
  fi
  mapfile -t cands < <(adb_candidates)
  for i in "${!cands[@]}"; do
    if ! is_distro_build "${cands[i]}"; then def=$((i + 1)); break; fi
  done
  ndev=$(adb devices 2>/dev/null | tail -n +2 | grep -c . || true)

  while true; do
    echo
    echo "  Restart the adb server with:"
    for i in "${!cands[@]}"; do
      c=${cands[i]}
      printf '    %d) %s  [%s]%s%s\n' $((i + 1)) "$c" "$(adb_version "$c")" \
        "$(is_distro_build "$c" && echo ' (distro build, likely no mDNS)')" \
        "$( ((i + 1 == def)) && echo '  ← recommended')"
    done
    echo "    o) same as $def, with ADB_MDNS_OPENSCREEN=1"
    echo "    q) quit"
    ((ndev > 0)) && warn "$ndev connected device(s) will drop; USB ones reconnect by themselves, wireless ones need 'adb connect' again."
    read -rp "  Choice [$def]: " choice
    choice=${choice:-$def}
    local extra=()
    case $choice in
      q | Q) exit 1 ;;
      o | O) ADB=${cands[def - 1]}; extra=(ADB_MDNS_OPENSCREEN=1) ;;
      *)
        if [[ $choice =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= ${#cands[@]})); then
          ADB=${cands[choice - 1]}
        else
          warn "invalid choice"; continue
        fi ;;
    esac
    info "Restarting adb server with $ADB ${extra[*]}"
    adb kill-server >/dev/null 2>&1 || true
    env "${extra[@]}" "$ADB" start-server >/dev/null 2>&1 || true
    if mdns_ok; then
      ok "adb server now supports mDNS"
      return 0
    fi
    warn "still no mDNS support with that choice; try another."
  done
}

adb start-server >/dev/null 2>&1 || true
mdns_ok || fix_mdns_wizard

# Print "<ip:port>" of the first discovered service matching type (and optional name).
find_service() { # $1=service type, $2=instance name (optional)
  adb mdns services 2>/dev/null | awk -v t="$1" -v n="${2:-}" '
    $0 ~ t && (n == "" || $1 == n) { print $NF; exit }'
}

wait_for_service() { # $1=type, $2=name (optional); echoes ip:port
  local deadline=$((SECONDS + TIMEOUT)) addr spin='|/-\' i=0
  while ((SECONDS < deadline)); do
    addr=$(find_service "$1" "${2:-}")
    if [[ -n $addr ]]; then printf '\r\e[K' >&2; echo "$addr"; return 0; fi
    printf '\r  waiting for device %s (%ds left) ' "${spin:i++%4:1}" $((deadline - SECONDS)) >&2
    sleep 1
  done
  printf '\r\e[K' >&2
  return 1
}

rand() { local s; s=$(set +o pipefail; LC_ALL=C tr -dc "$1" </dev/urandom 2>/dev/null | head -c "$2"); echo "$s"; }

if [[ $MODE == qr ]]; then
  NAME="adb-qr-$(rand 'a-z0-9' 8)"
  PASS="$(rand 'A-Za-z0-9' 12)"
  echo
  qrencode -t ANSIUTF8 -m 2 "WIFI:T:ADB;S:${NAME};P:${PASS};;"
  echo
  info "Phone: Developer options → Wireless debugging → Pair device with QR code"
  info "Service: $NAME"
  ADDR=$(wait_for_service "_adb-tls-pairing._tcp" "$NAME") || die "timed out waiting for the device to scan the QR code"
else
  info "Phone: Developer options → Wireless debugging → Pair device with pairing code"
  ADDR=$(wait_for_service "_adb-tls-pairing._tcp") || die "timed out; no device advertising a pairing service"
  info "Found pairing service at $ADDR"
  read -rp "  Enter the 6-digit pairing code: " PASS
  [[ $PASS =~ ^[0-9]{6}$ ]] || die "pairing code must be 6 digits"
fi

info "Pairing with $ADDR ..."
OUT=$(adb pair "$ADDR" "$PASS" 2>&1) || true
echo "  $OUT"
grep -qi "successfully paired" <<<"$OUT" || die "pairing failed"
ok "Paired"

if ((CONNECT)); then
  HOST=${ADDR%:*}
  # The phone usually auto-connects after QR pairing; otherwise find its connect port.
  sleep 2
  DEVS=$(adb devices)
  if grep -q "^${HOST}:" <<<"$DEVS"; then
    ok "Connected: $(adb devices | awk -v h="$HOST" 'index($1,h":")==1{print $1; exit}')"
  else
    CADDR=$( (adb mdns services 2>/dev/null | awk -v h="$HOST" '/_adb-tls-connect/ && index($NF,h":")==1 {print $NF; exit}') )
    if [[ -n $CADDR ]]; then
      adb connect "$CADDR" && ok "Connected: $CADDR"
    else
      info "Paired, but couldn't find the connect port. Run: adb connect $HOST:<port shown under Wireless debugging>"
    fi
  fi
fi
